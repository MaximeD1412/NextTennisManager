{
  "name": "next-tennis-manager-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite --host 0.0.0.0",
    "dev:ui-only": "vite --host 0.0.0.0",
    "generate:proto": "grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --proto_path=../../shared/proto ../../shared/proto/simulator.proto",
    "build": "npm run build:wasm && vite build",
    "build:with-proto": "npm run generate:proto && npm run build",
    "build:wasm": "cargo build -p physics-debug-wasm --target wasm32-unknown-unknown --release && node ./scripts/copy-physics-wasm.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "grpc-tools": "^1.12.4",
    "ts-proto": "^1.170.0",
    "typescript": "^5.4.5",
    "vite": "^8.0.14"
  }
}
